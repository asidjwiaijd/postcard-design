# 只有这四项必须写在这里——它们在进程启动前就要用到，
# 其余所有设置都在后台「设置」页里改，存数据库，重启不丢。

# ---- 必填 ----
# 后台管理密码。不设置的话生产环境无法登录后台。
ADMIN_PASSWORD=换成一个强密码
# 会话签名密钥。换成随机长字符串；改动后所有人需要重新登录。
SESSION_SECRET=用 openssl rand -base64 32 生成

# ---- 存储 ----
# 数据库和图片都放这里，做备份就备份这一个目录。
# 这一项也不能在后台改：数据库本身就在里面。
DATA_DIR=./data

# ---- 以下全部是「首次启动时的默认值」----
# 后台改过之后，这里再改就不起作用了（后台的值优先）。
# 想让这些默认值重新生效，在后台点「恢复默认」。

# 明信片规格
CARD_WIDTH_MM=148
CARD_HEIGHT_MM=100
CARD_BLEED_MM=3
CARD_SAFE_MM=4
CARD_DPI=300

# 限额
LIMIT_SUBMISSIONS_PER_USER=3
# 整站累计最多收多少张，0 = 不限
LIMIT_TOTAL_SUBMISSIONS=0
LIMIT_UPLOADS_PER_USER=30
LIMIT_UPLOAD_MAX_BYTES=20971520
LIMIT_UPLOAD_MAX_EDGE=2600
# 单张素材入库后的目标体积（字节），超了自动降质量压
LIMIT_UPLOAD_TARGET_BYTES=1310720
LIMIT_RENDER_TARGET_BYTES=3145728
LIMIT_RENDER_UPLOAD_MAX_BYTES=62914560

# 站点文案
SITE_NAME=社团明信片工坊
CLUB_NAME=米娜的社团
# 提交后是否立刻允许下载；关掉则要等审核通过
SITE_DOWNLOAD_BEFORE_REVIEW=true
# 首页是否展示实时作品墙（只放缩略图和昵称，不露 QQ 号）
SITE_GALLERY=true
# 作品墙只放审核通过的
SITE_GALLERY_APPROVED_ONLY=false

# 主机映射端口，docker compose 用
APP_PORT=3000

# cookie 是否加 Secure。留空=按 x-forwarded-proto 自动判断；
# 套了 https 反代却没转发该头时设成 true
# COOKIE_SECURE=true
